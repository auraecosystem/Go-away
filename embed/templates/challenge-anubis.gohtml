<!DOCTYPE html>
{{$logo := print .Path "/assets/static/logo.png?cacheBust=" .Random }}{{ if .Logo }}{{$logo = .Logo}}{{ end }}
<html>
<head>
    <meta charset="utf-8"/>
    <title>{{ .Title }}</title>
    <link rel="stylesheet" href="{{ .Path }}/assets/static/anubis/style.css?cacheBust={{ .Random }}"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="referrer" content="origin"/>
    <meta name="color-scheme" content="light dark"/>
    {{ range .MetaTags }}
    <meta {{ range $key, $value := . }}{{ $key | attr }}="{{ $value }}" {{end}}/>
    {{ end }}
    {{ range .LinkTags }}
    <link {{ range $key, $value := . }}{{ $key | attr }}="{{ $value }}" {{end}}/>
    {{ end }}
    {{ range .HeaderTags }}
    {{ . }}
    {{ end }}
</head>
<body id="top" data-state="{{ if .Error }}error{{ else if .Status }}waiting{{ else if .Challenge }}loading{{ end }}">
<main>
    <article class="ticket">
        <div class="ticket-main">
            <img id="image" class="logo{{ if not .Logo }} logo-default{{ end }}" src="{{ $logo }}" alt=""/>
            <h1 id="title">{{ .Title }}</h1>

            {{if .Status }}
            <p id="status">{{ .Status }}</p>
            {{else if .Challenge }}
            <p id="status">{{ .Strings.Get "status_loading_challenge" }} <em>{{ .Challenge }}</em>...</p>
            {{else if .Error}}
            <p id="status">{{ .Strings.Get "status_error" }} {{ .Error }}</p>
            {{else}}
            <p id="status">{{ .Strings.Get "status_loading" }}</p>
            {{end}}
            {{ range .ChallengeTags }}
                {{ . }}
            {{ end }}

            {{if .Redirect }}
                <a class="button" role="button" href="{{ .Redirect }}">{{ .Strings.Get "button_refresh_page" }}</a>
            {{end}}

            {{if .EndTags }}
                <noscript>
                    {{ .Strings.Get "noscript_warning" }}
                </noscript>
            {{end}}
        </div>

        <div class="ticket-stub">
            <details>
                <summary>{{ .Strings.Get "details_title" }}</summary>

                {{.Strings.Get "details_text"}}
            </details>

            <p class="request-id">
                {{ .Strings.Get "details_contact_admin_with_request_id" }}:
                <code>{{ .Id }}</code>
            </p>
        </div>
    </article>

    <footer>
        <span>Protected by <a href="https://git.gammaspectra.live/git/go-away">go-away</a></span>
        {{ range .Links }}
            <a href="{{ .URL }}">{{ .Name }}</a>
        {{ end }}
    </footer>

    {{ range .EndTags }}
        {{ . }}
    {{ end }}
</main>
</body>
</html>
